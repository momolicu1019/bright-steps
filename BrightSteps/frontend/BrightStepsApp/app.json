
{
  "expo": {
    "name": "BrightSteps",
    "slug": "brightsteps-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#FFF9E5" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.brightsteps.app" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#FFF9E5" },
      "package": "com.brightsteps.app",
      "permissions": ["RECORD_AUDIO"],
      "buildType": "apk"
    },
    "web": { "favicon": "./assets/favicon.png" },
    "extra": {
      "apiUrl": "https://your-backend.onrender.com/api",
      "offlineMode": true,
      "eas": { "projectId": "replace-with-your-eas-project-id" }
    }
  }
}
